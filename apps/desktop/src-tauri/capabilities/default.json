{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/mote-sidecar", "sidecar": true, "args": true }]
    }
  ]
}
